{
    "name": "shine-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "prepare": "husky",
        "pre-commit": "svelte-kit sync && pnpm run lint && pnpm run check && pnpm run test:unit --run",
        "mkcert:ca": "mkcert create-ca --organization \"Shine WEB Test CA\" --cert ./certificates/ca.crt --key ./certificates/ca.key",
        "mkcert:cert": "mkcert create-cert --ca-cert ./certificates/ca.crt --ca-key ./certificates/ca.key --cert ./certificates/cert.crt --key ./certificates/cert.key --domain local.scytta.com",
        "mkcert": "pnpm run mkcert:ca && pnpm run mkcert:cert",
        "env:mock": "pnpm dlx msw init && tsx scripts/select-config.ts mock",
        "env:local": "tsx scripts/select-config.ts local",
        "env:dev": "tsx scripts/select-config.ts dev",
        "env:prod": "tsx scripts/select-config.ts prod",
        "dev": "vite dev",
        "build": "vite build",
        "build:svgParser": "pnpm dlx peggy -c src/components/atoms/svg/peggy.config.js && node scripts/fix-parser.js",
        "build:assets": "cd ../shine-assets && pnpm run convert:web --out=../shine-web/static-generated/assets",
        "build:css": "pnpm dlx @tailwindcss/cli -i ./src/app.css -o ./temp/app.css",
        "build:storybook": "storybook build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "knip": "knip",
        "audit:check": "pnpm audit --audit-level=moderate",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "test": "pnpm run test:unit --run && pnpm run test:component && pnpm run test:integration",
        "test:unit": "vitest",
        "test:unit-ui": "vitest --ui --open",
        "test:component": "playwright test component",
        "test:integration": "playwright test integration",
        "test:e2e": "playwright test e2e",
        "storybook": "storybook dev -p 6006"
    },
    "dependencies": {
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "loglevel": "^1.9.2",
        "tailwind-merge": "^3.7.0",
        "ua-parser-js": "^2.0.10",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-svelte-csf": "^5.1.5",
        "@storybook/sveltekit": "^10.6.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.7",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/ui": "5.0.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.6.1",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.13.0",
        "happy-dom": "20.11.2",
        "husky": "^9.1.7",
        "knip": "^6.39.0",
        "mkcert": "^3.2.0",
        "msw": "^3.0.1",
        "playwright": "^1.63.0",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "storybook": "^10.6.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "turnstile-types": "^1.2.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.2.2",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0"
    },
    "msw": {
        "workerDirectory": [
            "static-generated"
        ]
    }
}
