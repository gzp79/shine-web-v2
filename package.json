{
    "name": "shine-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "pre-commit": "svelte-kit sync && pnpm run lint && pnpm run check && pnpm run test:unit --run",
        "mkcert": "cd certificates && mkcert create-ca && mkcert create-cert --domains local.scytta.com",
        "env:mock": "pnpm dlx msw init && tsx scripts/select-config.ts mock",
        "env:local": "tsx scripts/select-config.ts local",
        "env:dev": "tsx scripts/select-config.ts dev",
        "env:prod": "tsx scripts/select-config.ts prod",
        "dev": "vite dev",
        "build": "vite build",
        "build:svgParser": "pnpm dlx peggy -c src/components/atoms/svg/peggy.config.js && node scripts/fix-parser.js",
        "build:assets": "cd ../shine-assets && pnpm run convert:web:ui --out=../shine-web/static-generated/assets",
        "build:css": "pnpm dlx @tailwindcss/cli -i ./src/app.css -o ./temp/app.css",
        "build:storybook": "storybook build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "audit:check": "pnpm audit --audit-level=moderate",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "test": "pnpm run test:unit --run && pnpm run test:component && pnpm run test:e2e",
        "test:unit": "vitest",
        "test:unit-ui": "vitest --ui --open",
        "test:e2e": "playwright test e2e",
        "test:component": "playwright test component",
        "storybook": "storybook dev -p 6006",
        "hp-translator": "node tools/hp-translator/server.mjs"
    },
    "dependencies": {
        "bits-ui": "^2.16.2",
        "clsx": "^2.1.1",
        "loglevel": "^1.9.2",
        "prune": "^0.0.2",
        "sveltekit-i18n": "^2.4.2",
        "tailwind-merge": "^3.5.0",
        "turnstile-types": "^1.2.3",
        "ua-parser-js": "^2.0.9",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@anthropic-ai/bedrock-sdk": "^0.26.4",
        "@eslint/compat": "^2.0.2",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "@storybook/addon-svelte-csf": "^5.0.11",
        "@storybook/sveltekit": "^10.2.12",
        "@stylistic/eslint-plugin": "^5.9.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.55.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/debug": "^4.1.12",
        "@types/node": "^25.3.0",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "4.0.18",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.2.12",
        "eslint-plugin-svelte": "^3.16.0",
        "globals": "^17.3.0",
        "happy-dom": "^20.7.0",
        "husky": "^9.1.7",
        "mkcert": "^3.2.0",
        "msw": "^2.12.10",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "storybook": "^10.2.12",
        "svelte": "^5.55.0",
        "svelte-check": "^4.4.3",
        "tailwindcss": "^4.2.1",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vite-plugin-static-copy": "^3.2.0",
        "vitest": "^4.0.18",
        "wrangler": "^4.77.0"
    },
    "msw": {
        "workerDirectory": [
            "static-generated"
        ]
    },
    "pnpm": {
        "overrides": {
            "flatted@<3.4.0": "^3.4.0",
            "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
            "devalue@<5.6.4": "^5.6.4",
            "postcss-load-config@<4.0.0": "^4.0.2",
            "cookie@<0.7.0": "^0.7.0"
        }
    }
}
