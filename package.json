{
    "name": "shine-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "prepare": "husky",
        "pre-commit": "svelte-kit sync && pnpm run lint && pnpm run check && pnpm run test:unit --run",
        "mkcert:ca": "mkcert create-ca --organization \"Shine WEB Test CA\" --cert ./certificates/ca.crt --key ./certificates/ca.key",
        "mkcert": "pnpm run mkcert:ca && mkcert create-cert --ca-cert ./certificates/ca.crt --ca-key ./certificates/ca.key --cert ./certificates/cert.crt --key ./certificates/cert.key --domain local.scytta.com assets.local.scytta.com",
        "env:mock": "pnpm dlx msw init && tsx scripts/select-config.ts mock",
        "env:local": "tsx scripts/select-config.ts local",
        "env:dev": "tsx scripts/select-config.ts dev",
        "env:prod": "tsx scripts/select-config.ts prod",
        "dev": "vite dev",
        "build": "vite build",
        "build:svgParser": "pnpm dlx peggy -c src/components/atoms/svg/peggy.config.js && node scripts/fix-parser.js",
        "build:assets": "cd ../shine-assets && pnpm run convert:web --out=../shine-web/static-generated/assets",
        "build:css": "pnpm dlx @tailwindcss/cli -i ./src/app.css -o ./temp/app.css",
        "build:storybook": "storybook build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "knip": "knip",
        "audit:check": "pnpm audit --audit-level=moderate",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "test": "pnpm run test:unit --run && pnpm run test:component && pnpm run test:integration",
        "test:unit": "vitest",
        "test:unit-ui": "vitest --ui --open",
        "test:component": "playwright test component",
        "test:integration": "playwright test integration",
        "test:e2e": "playwright test e2e",
        "storybook": "storybook dev -p 6006"
    },
    "dependencies": {
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "loglevel": "^1.9.2",
        "sveltekit-i18n": "^2.4.2",
        "tailwind-merge": "^3.6.0",
        "ua-parser-js": "^2.0.10",
        "uuid": "^13.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-svelte-csf": "^5.1.2",
        "@storybook/sveltekit": "^10.5.9",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.5",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/debug": "^4.1.13",
        "@types/node": "^25.9.5",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "4.1.11",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.5.9",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "happy-dom": "^20.11.2",
        "husky": "^9.1.7",
        "knip": "^6.32.2",
        "mkcert": "^3.2.0",
        "msw": "^2.15.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "0.7.2",
        "storybook": "^10.5.9",
        "svelte": "^5.56.9",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "turnstile-types": "^1.2.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.6",
        "vite-plugin-static-copy": "^3.4.0",
        "vitest": "^4.1.11",
        "wrangler": "^4.124.0"
    },
    "msw": {
        "workerDirectory": [
            "static-generated"
        ]
    }
}
