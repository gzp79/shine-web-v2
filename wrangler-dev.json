{
    "name": "shine-dev",
    "compatibility_date": "2025-04-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "routes": [
        {
            "pattern": "dev.scytta.com",
            "custom_domain": true
        }
    ]
}
